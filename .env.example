# TreeGuard Environment Variables
# Copy to .env and fill in values

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/treeguard

# Google Gemini API Key (optional - demo mode works without it)
GEMINI_API_KEY=

# API Server Port
PORT=5001

# Frontend API URL (used by Vite)
VITE_API_URL=http://localhost:5001

# Supabase Backend
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
