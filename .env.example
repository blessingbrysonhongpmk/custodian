# TreeGuard Environment Variables
# Copy to .env and fill in values

# PostgreSQL connection string (for API server)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/treeguard

# Google Gemini API Key (optional - demo mode works without it)
GEMINI_API_KEY=

# API Server Port
PORT=5001

# Frontend API URL (used by Vite)
VITE_API_URL=http://localhost:5001

# Supabase Backend (optional - demo mode works without it)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Firebase Configuration (optional - demo mode works without it)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
