{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "dev:app": "node ./scripts/dev.mjs",
    "dev:mockup": "node ./scripts/dev-mockup.mjs",
    "dev:api": "node ./scripts/dev-api.mjs",
    "dev:all": "node ./scripts/start-all.mjs",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "tsc --build"
  },
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "lib/integrations/*",
    "scripts"
  ],
  "private": true,
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "vite": "^7.3.2"
  }
}
